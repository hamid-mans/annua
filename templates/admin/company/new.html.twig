{% extends 'admin.base.html.twig' %}

{% block title %}Nouvelle société{% endblock %}

{% block body %}
    <a href="{{ path('admin.company.index') }}" class="text-sm text-base-content/60 hover:text-base-content">← Retour aux sociétés</a>

    <h1 class="mb-6 mt-3 text-2xl font-bold tracking-tight">Nouvelle société</h1>

    <div class="max-w-xl rounded-box border border-base-300/70 bg-base-100 p-6">
        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        {% if form.vars.errors|length > 0 %}
            <div role="alert" class="alert alert-soft alert-error mb-5">
                    <span>
                        {% for error in form.vars.errors %}{{ error.message }} {% endfor %}
                    </span>
            </div>
        {% endif %}

        <div class="mb-5 space-y-1.5">
            {{ form_label(form.name, null, {label_attr: {class: 'block text-sm font-medium'}}) }}
            {{ form_widget(form.name, {attr: {class: 'input w-full' ~ (form.name.vars.errors|length > 0 ? ' input-error' : '')}}) }}
            {% for error in form.name.vars.errors %}
                <p class="text-sm text-error">{{ error.message }}</p>
            {% endfor %}
        </div>

        <div class="mt-6 flex items-center gap-2">
            <button type="submit" class="btn btn-primary btn-sm">Créer la société</button>
            <a href="{{ path('admin.company.index') }}" class="btn btn-ghost btn-sm">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
