<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}{% endblock %} - Annua Admin</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('theme');
                if (!theme) {
                    theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'annua-dark' : 'annua';
                }
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) {}
        })();
    </script>
    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

    {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>
<body class="min-h-screen bg-base-200 font-sans text-base-content antialiased">
{% set current_route = app.request.attributes.get('_route') %}
{% set alert_classes = {
    success: 'alert-success',
    error: 'alert-error',
    danger: 'alert-error',
    warning: 'alert-warning',
    info: 'alert-info',
    notice: 'alert-info',
} %}

<div class="sticky top-0 z-40">
    <div class="h-[3px] bg-accent"></div>

    <header class="navbar h-[65px] shrink-0 border-b border-base-300/70 bg-base-100 px-4 shadow-sm lg:px-6">
        <div class="flex flex-none items-center gap-2">
            <div class="dropdown lg:hidden">
                <button type="button" tabindex="0" class="btn btn-ghost btn-square" aria-label="Ouvrir le menu">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
                <ul tabindex="0" class="menu dropdown-content z-50 mt-3 w-56 rounded-box border border-base-300/70 bg-base-100 p-2 shadow-xl">
                    <li>
                        <a href="{{ path('admin.company.index') }}" class="top-nav-link {{ current_route starts with 'admin.company' ? 'active' : '' }}">
                            {{ ux_icon('solar:buildings-2-outline', {class: 'size-5'}) }}
                            <span>Sociétés</span>
                        </a>
                    </li>
                </ul>
            </div>

            <a href="{{ path('admin.company.index') }}" class="ml-2 flex items-center transition-opacity hover:opacity-80 lg:ml-0 lg:mr-8" aria-label="Annua Admin - Accueil">
                <img src="{{ asset('images/Annua-White-BG.png') }}" class="h-7 w-auto mix-blend-multiply dark:mix-blend-screen dark:invert" alt="Logo Annua">
            </a>
        </div>

        <nav class="hidden flex-1 items-center gap-1 lg:flex" aria-label="Navigation principale">
            <a href="{{ path('admin.company.index') }}" class="top-nav-link {{ current_route starts with 'admin.company' ? 'active' : '' }}">
                {{ ux_icon('solar:buildings-2-outline', {class: 'size-5'}) }}
                <span>Sociétés</span>
            </a>
        </nav>

        <div class="ml-auto flex flex-none items-center gap-2">
            <label class="swap swap-rotate btn btn-ghost btn-circle btn-sm" title="Changer de thème">
                <input type="checkbox" id="theme-toggle" aria-label="Basculer entre thème clair et sombre">
                <svg class="swap-off size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <circle cx="12" cy="12" r="4"/>
                    <path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/>
                </svg>
                <svg class="swap-on size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>
                </svg>
            </label>

            {% if app.user %}
                <div class="dropdown dropdown-end">
                    <div tabindex="0" role="button" class="flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-3 py-1.5 transition-colors duration-150 hover:bg-base-300/40">
                        <div class="hidden flex-col text-right sm:flex">
                            <span class="text-sm font-semibold leading-tight">{{ app.user.userIdentifier }}</span>
                            <span class="mt-0.5 text-[10px] uppercase tracking-wide text-base-content/50">Administrateur</span>
                        </div>
                        <div class="flex size-8 items-center justify-center rounded-full bg-base-300 text-sm font-bold text-base-content">
                            {{ app.user.userIdentifier|first|upper }}
                        </div>
                    </div>

                    <ul tabindex="-1" class="menu dropdown-content z-[60] mt-3 w-52 rounded-box border border-base-300/70 bg-base-100 p-2 shadow-xl">
                        <li class="menu-title px-2 py-1 text-[11px] font-semibold uppercase tracking-wider opacity-50">Mon compte</li>
                        <li>
                            <a data-turbo="false" href="{{ path('app_logout') }}" class="mt-1 py-2 text-error hover:bg-error/10 hover:text-error">
                                {{ ux_icon('solar:logout-2-outline', {class: 'size-5'}) }}
                                Déconnexion
                            </a>
                        </li>
                    </ul>
                </div>
            {% endif %}
        </div>
    </header>
</div>

<main class="relative w-full">
    <div class="mx-auto w-full max-w-[1800px] p-4 sm:p-6 lg:p-8">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div role="alert" class="alert alert-soft {{ alert_classes[type] ?? 'alert-info' }} mb-6">
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </div>
</main>

<script>
    (function () {
        var toggle = document.getElementById('theme-toggle');
        if (!toggle) {
            return;
        }
        toggle.checked = document.documentElement.getAttribute('data-theme') === 'annua-dark';
        toggle.addEventListener('change', function () {
            var theme = toggle.checked ? 'annua-dark' : 'annua';
            document.documentElement.setAttribute('data-theme', theme);
            try {
                localStorage.setItem('theme', theme);
            } catch (e) {}
        });
    })();
</script>
</body>
</html>
