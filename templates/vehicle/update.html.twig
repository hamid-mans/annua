{% extends 'app.base.html.twig' %}

{% block title('Voiture ' ~ vehicle.id) %}

{% block body %}

    {# ===== En-tête ===== #}
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold">
                {{ (vehicle.brand ~ ' ' ~ vehicle.model)|trim ?: 'Marque et modèle à renseigner' }}
            </h1>
            <p class="text-sm text-base-content/60">{{ vehicle.category.label }}</p>

            <div class="flex items-center gap-3 mt-2">
                <span class="font-mono text-lg font-semibold tracking-widest border-2 border-base-content/70 rounded-md px-3 py-0.5">
                    {{ vehicle.registrationNumber }}
                </span>
                <span class="badge badge-outline">{{ vehicle.status.label }}</span>
            </div>
        </div>
    </div>

    {# ===== Indicateurs (à brancher : dernier relevé, échéances, affectation) ===== #}
    <div class="stats stats-vertical sm:stats-horizontal border border-base-300 bg-base-100 w-full mb-6">
        <div class="stat">
            <div class="stat-title">Dernier relevé</div>
            <div class="stat-value text-2xl">—</div>
        </div>
        <div class="stat">
            <div class="stat-title">Prochaine échéance</div>
            <div class="stat-value text-2xl">—</div>
        </div>
        <div class="stat">
            <div class="stat-title">Conducteur actuel</div>
            <div class="stat-value text-2xl">—</div>
        </div>
    </div>

    {{ form_start(form, {attr: {id: 'vehicle-form'}}) }}
    {{ form_errors(form) }}

    {# ===== Onglets ===== #}
    <div class="tabs tabs-border">

        {# --- Fiche : le SEUL onglet qui contient le formulaire --- #}
        <input type="radio" name="main_tab" class="tab" aria-label="Fiche" checked />
        <div class="tab-content pt-6">


            <section class="card card-border bg-base-100 mb-6">
                <div class="card-body">
                    <h2 class="card-title text-base">Identification</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-x-6">
                        <div class="field">{{ form_row(form.registrationNumber) }}</div>
                        <div class="field">{{ form_row(form.vin) }}</div>
                        <div class="field">{{ form_row(form.category) }}</div>
                        <div class="field">{{ form_row(form.status) }}</div>
                        <div class="field">{{ form_row(form.brand) }}</div>
                        <div class="field">{{ form_row(form.model) }}</div>
                        <div class="field">{{ form_row(form.color) }}</div>
                    </div>
                </div>
            </section>

            <section class="card card-border bg-base-100 mb-6">
                <div class="card-body">
                    <h2 class="card-title text-base">Motorisation et masses</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-x-6">
                        <div class="field">{{ form_row(form.energy) }}</div>
                        <div class="field">{{ form_row(form.engineDisplacement) }}</div>
                        <div class="field">{{ form_row(form.netPowerKw) }}</div>
                        <div class="field">{{ form_row(form.fiscalPower) }}</div>
                        <div class="field">{{ form_row(form.co2Emissions) }}</div>
                        <div class="field">{{ form_row(form.seatCount) }}</div>
                        <div class="field">{{ form_row(form.unladenMass) }}</div>
                        <div class="field">{{ form_row(form.maxLadenMass) }}</div>
                        <div class="field">{{ form_row(form.maxCombinedMass) }}</div>
                    </div>
                </div>
            </section>

            <section class="card card-border bg-base-100 mb-6">
                <div class="card-body">
                    <h2 class="card-title text-base">Certificat d'immatriculation</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-x-6">
                        <div class="field">{{ form_row(form.firstRegistrationDate) }}</div>
                        <div class="field">{{ form_row(form.currentRegistrationDate) }}</div>
                        <div class="field">{{ form_row(form.typeApprovalNumber) }}</div>
                        <div class="field">{{ form_row(form.variantType) }}</div>
                        <div class="field">{{ form_row(form.cnit) }}</div>
                        <div class="field">{{ form_row(form.euCategory) }}</div>
                        <div class="field">{{ form_row(form.nationalGenre) }}</div>
                        <div class="field">{{ form_row(form.bodyType) }}</div>
                    </div>
                </div>
            </section>

        </div>

        {# --- Documents : carte grise, assurance + GED (hors formulaire principal) --- #}
        <input type="radio" name="main_tab" class="tab" aria-label="Documents" />
        <div class="tab-content pt-6">
            <p class="text-base-content/60">Documents officiels et fichiers du véhicule : bientôt.</p>
        </div>

        {# --- Échéances --- #}
        <input type="radio" name="main_tab" class="tab" aria-label="Échéances" />
        <div class="tab-content pt-6">
            <p class="text-base-content/60">Échéances du véhicule : bientôt.</p>
        </div>

    </div>

    {{ form_end(form) }}

    <twig:Modal id="modal_delete_vehicle" title="Confirmer la suppression">
        <twig:block name="body">
            <p>Êtes-vous sûr de vouloir supprimer le véhicule <span class="font-bold">{{ vehicle.registrationNumber }}</span> ?</p>
        </twig:block>

        <twig:block name="actions">
            <form id="delete-vehicle-{{ vehicle.id }}" method="post" action="{{ path('app.vehicle.delete', { id: vehicle.id }) }}">
                <input type="hidden" name="_method" value="DELETE">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-vehicle-' ~ vehicle.id) }}">

                <button class="btn btn-error">Supprimer</button>
            </form>
        </twig:block>
    </twig:Modal>

{% endblock %}

{% block magic_bar %}
    <span class="text-sm text-base-content/60 font-mono">{{ vehicle.registrationNumber }}</span>

    <div class="ml-auto flex items-center gap-2">
        <button type="submit" form="vehicle-form" class="btn btn-sm btn-primary">Enregistrer</button>
        <a href="{{ path('app.vehicle.index') }}" class="btn btn-sm btn-ghost">Annuler</a>

        <button type="button" class="btn btn-sm btn-ghost" onclick="window.print()">Imprimer</button>

        <div class="dropdown dropdown-top dropdown-end">
            <div tabindex="0" role="button" class="btn btn-sm btn-square btn-ghost" aria-label="Plus d'actions">⋯</div>
            <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-10 mb-2 w-48 p-2 shadow border border-base-300">
                <li><button type="button" class="text-error" onclick="modal_delete_vehicle.showModal()">Supprimer</button></li>
            </ul>
        </div>
    </div>
{% endblock %}
