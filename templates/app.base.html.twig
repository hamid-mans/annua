<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}{% endblock %} - Annua</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('theme');
                if (!theme) {
                    theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'annua-dark' : 'annua';
                }
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) {}
        })();
    </script>
    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

    {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>
<body class="flex min-h-screen flex-col bg-base-200 font-sans text-base-content antialiased bg-dots">
{% set current_route = app.request.attributes.get('_route') %}

{% set current_route = app.request.attributes.get('_route') ?? '' %}
{% set nav_items = [
    {label: 'Accueil', icon: 'lucide:house', route: 'app.index', active: current_route == 'app.index'},
    {label: 'Véhicules', icon: 'lucide:car', route: 'app.vehicle.index', active: current_route starts with 'app.vehicle.'},
    {label: 'Échéances', icon: 'lucide:calendar-clock', route: null, active: false},
    {label: 'Conducteurs', icon: 'lucide:users', route: null, active: false},
    {label: 'Paramètres', icon: 'lucide:settings-2', route: null, active: false},
] %}

<header class="sticky top-0 z-40 flex h-12 shrink-0 items-stretch gap-8 border-b border-base-300/70 bg-base-100 px-4 lg:px-6">

    {# Menu mobile #}
    <div class="dropdown flex items-center lg:hidden">
        <button type="button" tabindex="0" class="btn btn-ghost btn-sm btn-square" aria-label="Ouvrir le menu">
            {{ ux_icon('lucide:menu', {class: 'size-5'}) }}
        </button>
        <ul tabindex="0" class="menu dropdown-content top-full z-50 mt-1 w-56 rounded-box border border-base-300 bg-base-100 p-1.5 shadow-lg">
            {% for item in nav_items %}
                <li>
                    <a href="{{ item.route ? path(item.route) : '#' }}" class="{{ item.active ? 'menu-active' }}">
                        {{ ux_icon(item.icon, {class: 'size-4'}) }}
                        {{ item.label }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>

    {# Logo #}
    <a href="{{ path('app.index') }}" class="flex items-center transition-opacity hover:opacity-80" aria-label="Annua - Accueil">
        {{ ux_icon('annua', {class: 'h-20 w-auto', 'aria-label': 'Annua'}) }}
    </a>

    {# Navigation principale #}
    <nav class="hidden items-stretch gap-6 lg:flex" aria-label="Navigation principale">
        {% for item in nav_items %}
            <a href="{{ item.route ? path(item.route) : '#' }}"
               class="top-nav-link {{ item.active ? 'active' }}"
                {{ item.active ? 'aria-current="page"' }}>
                {{ item.label }}
            </a>
        {% endfor %}
    </nav>

    {# Menu utilisateur #}
    <div class="dropdown dropdown-end ml-auto flex items-center">
        <div tabindex="0" role="button" class="flex cursor-pointer items-center gap-2 text-sm text-base-content/70 transition-colors hover:text-base-content">
            <span class="hidden sm:inline">{{ app.user.firstname }} {{ app.user.lastname }}</span>
            <span class="flex size-7 items-center justify-center rounded-full bg-base-content/10 text-xs font-medium text-base-content">
                {{ (app.user.firstname|default('')|first ~ app.user.lastname|default('')|first)|upper }}
            </span>
            {{ ux_icon('lucide:chevron-down', {class: 'size-3.5'}) }}
        </div>

        <div tabindex="0" class="dropdown-content top-full z-50 mt-1 w-60 rounded-box border border-base-300 bg-base-100 p-1.5 shadow-lg">
            <div class="mb-1 border-b border-base-300 px-3 pb-2 pt-1.5">
                <p class="text-sm font-medium">{{ app.user.firstname }} {{ app.user.lastname }}</p>
                <p class="text-xs text-base-content/50">{{ app.user.company.name }}</p>
            </div>

            <ul class="menu w-full p-0">
                <li>
                    <a href="#">{{ ux_icon('lucide:user-cog', {class: 'size-4 opacity-60'}) }} Mes réglages</a>
                </li>
                <li>
                    <label class="flex justify-between">
                        <span class="flex items-center gap-2">{{ ux_icon('lucide:moon', {class: 'size-4 opacity-60'}) }} Mode sombre</span>
                        <input type="checkbox" id="theme-toggle" class="toggle toggle-xs" aria-label="Mode sombre">
                    </label>
                </li>
            </ul>

            <div class="my-1 border-t border-base-300"></div>

            <ul class="menu w-full p-0">
                <li>
                    <a data-turbo="false" href="{{ path('app_logout') }}" class="text-error">{{ ux_icon('lucide:log-out', {class: 'size-4'}) }} Déconnexion</a>
                </li>
            </ul>
        </div>
    </div>
</header>

<main class="relative w-full flex-1">
    <div class="mx-auto w-full max-w-[1800px] p-4 sm:p-6 lg:px-9 lg:py-7">
        {% block body %}{% endblock %}
    </div>
</main>


{% set flashes = app.flashes %}
{% set flash_type = flashes|keys|first %}
{% set flash_message = flash_type ? flashes[flash_type]|first : null %}

<div class="pointer-events-none sticky bottom-0 z-30 flex justify-center px-4 pb-4 pt-2">
    <div
        data-controller="magic-bar"
        data-magic-bar-type-value="{{ flash_type }}"
        data-action="turbo:before-cache@document->magic-bar#reset"
        class="transition-transform duration-200 ease-out hover:scale-[1.05] pointer-events-auto flex max-w-full items-center gap-1 rounded-2xl border border-base-300 bg-base-100/80 py-2.5 px-2.5 shadow-lg backdrop-blur">
        {% block magic_bar %}
            <i>Aucune action possible ici...</i>
        {% endblock %}

        {% if flash_message %}
            <div class="magic-bar magic-bar-message" role="status">
                {{ ux_icon(flash_type == 'error' ? 'lucide:circle-x' : 'lucide:circle-check', {class: 'size-4'}) }}
                {{ flash_message|trans }}
            </div>
        {% endif %}
    </div>
</div>

<script>
    (function () {
        var toggle = document.getElementById('theme-toggle');
        if (!toggle) {
            return;
        }
        toggle.checked = document.documentElement.getAttribute('data-theme') === 'annua-dark';
        toggle.addEventListener('change', function () {
            var theme = toggle.checked ? 'annua-dark' : 'annua';
            document.documentElement.setAttribute('data-theme', theme);
            try {
                localStorage.setItem('theme', theme);
            } catch (e) {}
        });
    })();

</script>
</body>
</html>
