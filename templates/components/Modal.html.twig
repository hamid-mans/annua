{% props id, title = null, open = false %}

<dialog
    class="modal" id="{{ id }}"
    data-controller="modal"
    data-modal-open-value="{{ open ? 'true' : 'false' }}"
    {{ attributes }}
>

    <div class="modal-box">
        {% if title %}
            <h3 class="text-xl font-bold">{{ title }}</h3>
        {% endif %}

        <div class="py-4">
            {% block body %}{% endblock %}
        </div>

        <div class="modal-action">
            <button type="button" class="btn btn-ghost" onclick="this.closest('dialog').close()">Annuler</button>
            {% block actions %}{% endblock %}
        </div>
    </div>


    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>
