<div id="g2s-toast-container" class="toast toast-center z-[9999] pointer-events-none p-4 gap-3" style="top: 20px;">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-sm bg-base-100 border border-base-300 border-t-2 {{ type == 'success' ? 'border-t-success' : 'border-t-error' }} shadow-lg rounded-box min-w-[320px] max-w-[450px] pointer-events-auto flex items-center gap-3 p-4 g2s-toast-anim animate-fade-in" data-g2s-toast>
                {{ ux_icon(type == 'success' ? 'solar:check-circle-outline' : 'solar:sad-square-outline') }}
                <span class="text-sm font-medium text-base-content text-left">{{ message|trans }}</span>

                <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                     class="hidden"
                     onload="(function(el){
                        const toast = el.closest('[data-g2s-toast]');
                        if(toast && !toast.dataset.toastInitialized) {
                            toast.dataset.toastInitialized = 'true';
                            setTimeout(() => {
                                toast.classList.add('g2s-toast-out');
                                toast.addEventListener('animationend', () => toast.remove());
                            }, 3500);
                        }
                     })(this)" />
            </div>
        {% endfor %}
    {% endfor %}
</div>

{# 3. Animations fluides d'apparition/disparition #}
<style>
    .g2s-toast-anim {
        animation: g2s-drop-in 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .g2s-toast-out {
        animation: g2s-fade-out 0.25s ease forwards !important;
    }

    @keyframes g2s-drop-in {
        from { transform: translateY(-20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    @keyframes g2s-fade-out {
        from { transform: translateY(0) scale(1); opacity: 1; }
        to { transform: translateY(-10px) scale(0.95); opacity: 0; }
    }
</style>
