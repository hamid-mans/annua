<div {{ attributes }}>

    <div class="mb-3 flex flex-wrap items-start gap-2 mt-4">
        <div class="field flex-1">
            <input type="search" data-model="debounce(300)|query" placeholder="Rechercher…">
        </div>

        <div class="flex gap-2" role="group" aria-label="Filtrer par statut">
            {% for status in enum_cases('App\\Enum\\VehicleStatus') %}
                <label class="group inline-flex h-9 cursor-pointer select-none items-center gap-1.5 rounded-box border border-base-content/10 bg-base-100 px-3 text-sm text-base-content/70 transition-colors hover:border-base-content/40 has-checked:border-base-content has-checked:bg-base-content has-checked:text-base-100 has-focus-visible:outline-2 has-focus-visible:outline-offset-2">
                    <input type="checkbox" class="sr-only" data-model="statuses[]" value="{{ status.value }}" {{ status.value in statuses ? 'checked' }}>
                    {{ status.label }}
                </label>
            {% endfor %}
        </div>
    </div>

    <div class="table-div">
        <table class="table">
            <thead>
            <tr>
                <th>Immatriculation</th>
                <th>Catégorie</th>
                <th>Marque</th>
                <th>Modèle</th>
                <th>Couleur</th>
                <th>Année</th>
                <th>Kilométrage</th>
                <th>Conducteur</th>
            </tr>
            </thead>
            <tbody>
            {% for vehicle in this.pagination %}
                <tr data-controller="row-link" data-action="click->row-link#click" data-row-link-url-value="{{ path('app.vehicle.update', { id: vehicle.id }) }}">
                    <td>{{ vehicle.registrationNumber }}</td>
                    <td>{{ vehicle.category.label }}</td>
                    <td>{{ vehicle.brand }}</td>
                    <td>{{ vehicle.model }}</td>
                    <td>{{ vehicle.color }}</td>
                    <td>{{ vehicle.firstRegistrationDate ? vehicle.firstRegistrationDate|date('Y') : '—' }}</td>
                    <td>{{ '#' }}</td>
                    <td>{{ '#' }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-center text-base-content/60">Aucun véhicule</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {{ ux_pagination(this.pagination, link_attributes: this.paginationLinkAttributes, theme: '@UXPagination/theme/tailwind.html.twig', show_info: false) }}


</div>
